# 런타임 의존성은 NumPy 하나뿐이다(BSD-3-Clause). musl 휠이 없어 Debian slim을
# 기반으로 쓰고, 설치 도구는 최종 이미지에서 제거한다. 실행 중에는 아무것도
# 내려받지 않으며 네트워크 없이 동작한다.
FROM python:3.11-slim-bookworm@sha256:2e32f7d302adc1c37428355c1e646897c0c53f4fd60b6a551245fb90ee129f91

ARG SOURCE_MANIFEST_SHA256=unbound
LABEL io.sktelecom.ossp.source-manifest-sha256="${SOURCE_MANIFEST_SHA256}"
# 레지스트리에서 이미지가 어느 저장소에서 왔는지 확인할 수 있게 한다.
LABEL org.opencontainers.image.source="https://github.com/leelang7/ossp-2026-llm-router-challenge"
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.description="프롬프트 내용만으로 후보 모델 하나를 고르는 compute-efficient LLM 라우터"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/opt/router \
    PYTHONUNBUFFERED=1 \
    TMPDIR=/tmp \
    OPENBLAS_NUM_THREADS=2 \
    OMP_NUM_THREADS=2

COPY container/requirements-runtime.txt /tmp/requirements-runtime.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements-runtime.txt \
    && rm -f /tmp/requirements-runtime.txt \
    && python3 -m pip uninstall --yes pip setuptools wheel \
    && find /usr/local/lib/python3.11 -type d -name tests -prune -exec rm -rf {} +

# 루트 파일 시스템이 읽기 전용이라 실행 중에는 .pyc를 만들 수 없다. 미리 컴파일해
# 두지 않으면 등급 실행마다 표준 라이브러리를 다시 컴파일하며 몇 초를 버린다.
RUN python3 -m compileall -q /usr/local/lib/python3.11 || true

# 실행에 필요한 것만 넣는다. 운영자 오케스트레이션 코드(orchestrator, runtime,
# scoring 등)는 라우터가 쓰지 않으므로 이미지에서 제외한다.
COPY --chown=65532:65532 src/routerx /opt/router/routerx/
COPY --chown=65532:65532 src/ossp_router/__init__.py src/ossp_router/protocol.py /opt/router/ossp_router/
COPY --chown=65532:65532 src/ossp_router/resources /opt/router/ossp_router/resources/
COPY --chown=65532:65532 container/entrypoint_routerx.py /opt/router/entrypoint.py

WORKDIR /opt/router
USER 65532:65532

ENTRYPOINT ["python3", "/opt/router/entrypoint.py"]
